<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="test_master_product_list_view" model="ir.ui.view">
            <field name="name">test.master.product.view.list</field>
            <field name="model">test.master.products</field>
            <field name="arch" type="xml">
                <list string="Products">
                    <field name="product_name" string="Product Name" />
                    <field name="unit_type" string="Unit Type" />
                    <field name="construction_year" string="Construction Year" />
                    <field name="chasis" string="Chassis" />
                    <field name="no_engine" string="No Engine" />
                </list>
            </field>
        </record>

        <record id="test_master_product_view" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">test.master.products</field>
            <field name="view_mode">list,form</field>
        </record>               
    
    </data>
</odoo>
