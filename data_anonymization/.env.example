# Copy to .env for local development. Never commit real secrets.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ANONYMIZER_VALIDATION_SECRET=replace_with_long_random_service_secret
ANONYMIZER_CLIENT_API_KEY=replace_with_key_generated_in_odoo
ANONYMIZER_SERVICE_URL=http://127.0.0.1:8000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_with_generated_fernet_key
MAX_FILE_SIZE_MB=10

# URL must be reachable from the FastAPI container. Use the Odoo service name on a shared Docker network.
ANONYMIZER_ODOO_VALIDATION_URL=http://odoo:8069/data-anonymization/internal/validate-api-key
