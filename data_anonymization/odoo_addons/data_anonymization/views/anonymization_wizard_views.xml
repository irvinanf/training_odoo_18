<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_data_anonymization_wizard_form" model="ir.ui.view">
        <field name="name">data.anonymization.wizard.form</field>
        <field name="model">data.anonymization.wizard</field>
        <field name="arch" type="xml">
            <form string="Data Anonymization">
                <sheet>
                    <div class="oe_title"><h1>Data Anonymization</h1></div>
                    <group>
                        <field name="filename" invisible="1"/>
                        <field name="source_file" filename="filename" widget="binary"
                               options="{'accepted_file_extensions': '.csv,.xlsx,.xlsm'}"
                               required="1"/>
                    </group>
                    <group>
                        <button name="action_inspect_columns" type="object"
                                string="Periksa Kolom" class="oe_highlight" icon="fa-search"/>
                    </group>
                    <field name="columns_detected" invisible="1"/>
                    <separator string="Pilih Kolom dan Metode" invisible="not columns_detected"/>
                    <field name="line_ids" invisible="not columns_detected">
                        <list editable="bottom">
                            <field name="field_name"/>
                            <field name="selected"/>
                            <field name="method" readonly="not selected"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert" invisible="not columns_detected">
                        Pilih kolom yang ingin diproses. Kolom yang tidak dipilih tetap seperti data asli.
                    </div>
                    <separator string="File Hasil" invisible="not result_file"/>
                    <group invisible="not result_file">
                        <field name="result_filename" readonly="1"/>
                        <button name="action_download_result" type="object"
                                string="Download File Hasil" class="oe_highlight" icon="fa-download"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_anonymize" type="object"
                            string="Jalankan Anonimisasi" class="oe_highlight"
                            invisible="not columns_detected"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_data_anonymization" model="ir.actions.act_window">
        <field name="name">Data Anonymization</field>
        <field name="res_model">data.anonymization.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_data_anonymization_wizard_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_data_anonymization_root" name="Data Tools"
              sequence="80" groups="base.group_user"/>
    <menuitem id="menu_data_anonymization" name="Data Anonymization"
              parent="menu_data_anonymization_root" action="action_data_anonymization"
              sequence="10" groups="base.group_user"/>
</odoo>
