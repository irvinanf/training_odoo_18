<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="master_ruangan_form_view" model="ir.ui.view">
            <field name="name">master.ruangan.view.form</field>
            <field name="model">master.ruangan</field>
            <field name="arch" type="xml">
                <form>
                    <header string="Ruangan">
                    </header>
                    <sheet>
                        <group>
                            <field name="nama_ruangan" string="Nama Ruangan"/>
                            <field name="tipe_ruangan" string="Tipe Ruangan"/>
                            <field name="lokasi_ruangan" string="Lokasi Ruangan"/>
                            <field name="foto_ruangan" string="Foto Ruangan" optional="show" widget="image" />
                            <field name="kapasitas_ruangan" string="Kapasitas Ruangan"/>
                            <field name="keterangan" string="Keterangan" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="master_ruangan_list_view" model="ir.ui.view">
            <field name="name">master.ruangan.view.list</field>
            <field name="model">master.ruangan</field>
            <field name="arch" type="xml">
                <list string="Ruangan">
                    <field name="nama_ruangan" string="Nama Ruangan" />
                    <field name="tipe_ruangan" string="Tipe Ruangan" />
                    <field name="lokasi_ruangan" string="Lokasi Ruangan" />
                    <field name="kapasitas_ruangan" string="Kapasitas Ruangan" />
                    <field name="keterangan" string="Keterangan" />
                </list>
            </field>
        </record>

        <record id="master_ruangan_view" model="ir.actions.act_window">
            <field name="name">Master Ruangan</field>
            <field name="res_model">master.ruangan</field>
            <field name="view_mode">list,form</field>
        </record>
    
    </data>
</odoo>
