<odoo>
    <data>
        
        <record id="pemesanan_ruangan_view_form" model="ir.ui.view">
            <field name="name">pemesanan.ruangan.view.form</field>
            <field name="model">pemesanan.ruangan</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Approve" name="action_approve" type="object" class="btn_primary"
                        invisible="status_pemesanan != 'draft'"/>
                        <button string="Done" name="action_done" type="object" class="btn_primary"
                        invisible="status_pemesanan != 'on_going'"/>
                        <field name="status_pemesanan" widget="statusbar" statusbar_visible="draft,on_going,done"/> #fieldnya harus one2many
                    </header>
                    <sheet>
                        <group> 
                            <field name="no_pemesanan" />
                            <field name="ruangan"/>
                            <field name="nama_pemesan" />
                            <field name="tgl_pemesanan" />
                            <field name="catatan_pemesanan" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="pemesanan_ruangan_view_list" model="ir.ui.view">
            <field name="name">pemesanan.ruangan.view.list</field>
            <field name="model">pemesanan.ruangan</field>
            <field name="arch" type="xml">
                <list string="Pemesanan Ruangan" default_order="no_pemesanan desc">
                    <field name="no_pemesanan" />
                    <field name="ruangan" />
                    <field name="nama_pemesan" />
                    <field name="tgl_pemesanan" />
                    <field name="status_pemesanan" />
                </list>
            </field>
        </record>
        
        <record id="pemesanan_ruangan_sequence" model="ir.sequence">
            <field name="name">No. Pemesanan</field>
            <field name="code">pemesanan.ruangan</field>
            <field name="prefix">RB/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="pemesanan_ruangan_view" model="ir.actions.act_window">
            <field name="name">Pemesanan Ruangan</field>
            <field name="res_model">pemesanan.ruangan</field>
            <field name="view_mode">list,form</field>
        </record>
    
    </data>
</odoo>